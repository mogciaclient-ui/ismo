rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function canAccessSite(siteId) {
      let site = get(/databases/$(database)/documents/sites/$(siteId)).data;
      return signedIn() &&
        (site.ownerUid == request.auth.uid || request.auth.uid in site.memberUids);
    }

    match /sites/{siteId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids;
      allow read: if canAccessSite(siteId);
      allow update: if canAccessSite(siteId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberUids == resource.data.memberUids;
      allow delete: if false;

      match /events/{eventId} {
        allow read: if canAccessSite(siteId);
        allow write: if false;
      }
    }
  }
}
