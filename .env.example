NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-northeast1
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
NEXT_PUBLIC_MOGCIA_COLLECTOR_URL=https://asia-northeast1-YOUR_PROJECT.cloudfunctions.net/collect
NEXT_PUBLIC_MOGCIA_SITE_ID=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# AIはサーバー／Firebase Functionsからのみ呼び出す
# NEXT_PUBLIC_ は絶対に付けない
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
